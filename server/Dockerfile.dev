# Backend Development Dockerfile
FROM node:18-alpine

WORKDIR /app

# Install nodemon globally for hot reloading
RUN npm install -g nodemon ts-node

# Copy package files
COPY package*.json ./
RUN npm install

# Copy source code
COPY . .

# Expose port
EXPOSE 3001

# Start with nodemon for hot reloading
CMD ["npm", "run", "dev"]